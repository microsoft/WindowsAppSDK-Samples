<Project>
  <!-- Referenced WinUI class libraries are architecture-neutral. Keep their build and PRI paths
       aligned when the Shell-only solution is built for x86, x64, or ARM64. -->
  <Target Name="UseAnyCpuForProjectReferences" AfterTargets="AssignProjectConfiguration">
    <ItemGroup>
      <ProjectReferenceWithConfiguration Update="@(ProjectReferenceWithConfiguration)">
        <GlobalPropertiesToRemove>Platform</GlobalPropertiesToRemove>
        <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
        <SetPlatform>Platform=AnyCPU</SetPlatform>
        <AdditionalProperties>Configuration=$(Configuration);Platform=AnyCPU</AdditionalProperties>
      </ProjectReferenceWithConfiguration>
    </ItemGroup>
  </Target>
</Project>
