<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>WindowsAISample</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxOSMinVersionReplaceManifestVersion>false</AppxOSMinVersionReplaceManifestVersion>
    <AppxOSMaxVersionTestedReplaceManifestVersion>false</AppxOSMaxVersionTestedReplaceManifestVersion>
    <ExperimentalApisAvailable>false</ExperimentalApisAvailable>
    <ExperimentalApisAvailable Condition="$([System.String]::Copy('$(WindowsAppSDKVersion)').Contains('-experimental'))">true</ExperimentalApisAvailable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Extensions\**\*.cs" />
    <Compile Remove="Shared\**\*.cs" />
    <Page Remove="Extensions\**\*.xaml" />
    <Page Remove="Shared\**\*.xaml" />
    <None Remove="Extensions\**" />
    <None Remove="Shared\**" />
    <None Remove="Examples\ImageObjectExtractor.md" />
    <None Remove="Examples\ImageObjectExtractorInit.md" />
    <None Remove="Examples\ImageScaler.md" />
    <None Remove="Examples\LanguageModelWithContext.md" />
    <None Remove="Examples\LanguageModelWithOptionsAndProgress.md" />
    <None Remove="Examples\LanguageModelWithProgress.md" />
    <None Remove="Examples\TextRecognizer.md" />
    <None Remove="Examples\TextRecognizerInit.md" />
    <None Remove="Pages\ExampleCode.xaml" />
    <None Remove="Pages\ImageDescriptionPage.xaml" />
    <None Remove="Pages\ImageObjectExtractorPage.xaml" />
    <None Remove="Pages\ImageScalerPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Examples\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="Shared\WindowsAISample.Shared.csproj">
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <AdditionalProperties>Platform=AnyCPU</AdditionalProperties>
    </ProjectReference>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(ExperimentalApisAvailable)' == 'true'">
    <Compile Include="Extensions\ImageForegroundExtractor\ShellExtension.cs"
             Link="Extensions\ImageForegroundExtractor\ShellExtension.cs" />
    <Compile Include="Extensions\VideoScaler\ShellExtension.cs"
             Link="Extensions\VideoScaler\ShellExtension.cs" />
    <ProjectReference Include="Extensions\ImageForegroundExtractor\WindowsAISample.Ext.ImageForegroundExtractor.csproj">
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <AdditionalProperties>Platform=AnyCPU</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="Extensions\VideoScaler\WindowsAISample.Ext.VideoScaler.csproj">
      <SetPlatform>Platform=AnyCPU</SetPlatform>
      <AdditionalProperties>Platform=AnyCPU</AdditionalProperties>
    </ProjectReference>
    <Content Include="Extensions\ImageForegroundExtractor\Examples\*.md"
             Link="Examples\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Extensions\VideoScaler\Examples\*.md"
             Link="Examples\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ExtensionRequiringExperimentalApis Include="ImageForegroundExtractor" />
    <ExtensionRequiringExperimentalApis Include="VideoScaler" />
  </ItemGroup>

  <Target Name="RemoveStaleExtensionOutputs"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(ExperimentalApisAvailable)' != 'true'">
    <ItemGroup>
      <StaleExtensionFile Include="@(ExtensionRequiringExperimentalApis -> '$(TargetDir)WindowsAISample.Ext.%(Identity).dll')" />
      <StaleExtensionFile Include="@(ExtensionRequiringExperimentalApis -> '$(TargetDir)WindowsAISample.Ext.%(Identity).pdb')" />
      <StaleExtensionFile Include="@(ExtensionRequiringExperimentalApis -> '$(TargetDir)WindowsAISample.Ext.%(Identity).pri')" />
      <StaleExtensionDirectory Include="@(ExtensionRequiringExperimentalApis -> '$(TargetDir)WindowsAISample.Ext.%(Identity)')" />
    </ItemGroup>

    <Delete Files="@(StaleExtensionFile)" />
    <RemoveDir Directories="@(StaleExtensionDirectory)" />
  </Target>

  <!-- Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
      Tools extension to be activated for this project even if the Windows App SDK Nuget
      package has not yet been restored -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnablePreviewMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Assets\harbor.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Pages\ImageDescriptionPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Pages\ImageObjectExtractorPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Pages\ImageScalerPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Pages\ExampleCode.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="MagicEraserPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Pages\LanguageModelPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Pages\TextRecognizerPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <Import Project="ProjectReference.Platform.targets" />
</Project>
