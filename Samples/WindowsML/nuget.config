<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <config>
        <!-- Set the packages directory for packages.config projects (C++ projects) -->
        <add key="repositoryPath" value="packages" />
    </config>
    <!-- Run SamplesFeed-Hydration.yml whenever samples are updated. -->
    <!-- Do not add package sources other than WinAppSDK-SampleDeps or localpackages. -->
    <!-- The public feed is inherited from Samples/nuget.config. -->
    <packageSources>
        <!-- Optional local source for validating packages before the public feed is hydrated. -->
        <add key="localpackages" value="..\localpackages" />
    </packageSources>
</configuration>
